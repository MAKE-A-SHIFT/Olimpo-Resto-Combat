rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Members collection (100% Free Spark Tier optimized)
    match /members/{memberCode} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['code', 'name']);
    }
    // Orders collection
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
  }
}
